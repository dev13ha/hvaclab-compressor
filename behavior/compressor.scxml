<?xml version="1.0" encoding="UTF-8"?>
<!-- SYNTHETIC example behaviour for the OS20 HVAC lab. Not control software. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="RotaryCompressor" initial="off" datamodel="null">
  <state id="off">
    <transition event="cmd.start" target="starting"/>
    <transition event="fault.detected" target="fault"/>
  </state>
  <state id="starting">
    <!-- soft start: inverter ramps 0 to 30 Hz -->
    <transition event="start.complete" target="running"/>
    <transition event="cmd.stop" target="off"/>
    <transition event="fault.overcurrent" target="fault"/>
  </state>
  <state id="running">
    <transition event="cmd.stop" target="off"/>
    <transition event="fault.overcurrent" target="fault"/>
    <transition event="fault.highpressure" target="fault"/>
    <transition event="fault.dischargetemp" target="fault"/>
  </state>
  <state id="fault">
    <!-- 3 minute anti-short-cycle lockout before reset -->
    <transition event="fault.reset" target="off"/>
  </state>
</scxml>
